{
  "name": "dsh-release-proof",
  "version": "0.1.0",
  "description": "Reproducible multi-source release evidence for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": { ".": "./index.js", "./release-proof": "./lib/release-proof.mjs" },
  "bin": { "dsh-release-proof": "./bin/dsh-release-proof.mjs" },
  "files": [".codex-plugin/", "index.js", "lib/", "bin/", "cordis.patch.yml", "examples/", "README.md", "README.zh-CN.md", "LICENSE"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "peerDependencies": { "@deepseek-ai/dsh-tools": "*" },
